      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst rowsText = items.map((item, index) => {\n  const data = item.json;\n  return `${index + 1}. Name: ${data.Name || 'N/A'}\\n   Course: ${data.Course || 'N/A'}\\n   Status: ${data.Status || 'N/A'}`;\n}).join('\\n\\n');\n\nconst subject = 'Data Summary from Google Sheet';\n\nconst body = [\n  'Hi,',\n  '',\n  'Here is the latest data from the sheet:',\n  '',\n  rowsText,\n  '',\n  'Regards,',\n  'Your Automation Bot'\n].join('\\n');\n\nreturn [\n  {\n    json: {\n      subject,\n      body\n    }\n  }\n];"
      },
