# Application
APP_ENV=development
APP_NAME=PDF Intelligence Assistant
API_HOST=0.0.0.0
API_PORT=8001
UI_PORT=8502
API_BASE_URL=http://localhost:8001
PDF_ASSISTANT_API_KEY=local-dev-key-change-before-deployment
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=500
MAX_QUESTION_CHARS=3000
MAX_CHUNK_CHARS=1600
CHUNK_OVERLAP_CHARS=200
TOP_K_VECTOR=8
TOP_K_BM25=8
TOP_K_GRAPH=8
RRF_K=60
MIN_EVIDENCE_CHUNKS=1
MIN_RRF_SCORE=0.0
STORAGE_ROOT=./storage
SQLITE_PATH=./storage/app.db
OCR_ENABLED=false
OCR_LANG=eng
RERANKER_ENABLED=false
ANSWER_VERIFIER_ENABLED=true
QUERY_REWRITE_ENABLED=true

# OpenAI — required for embeddings, graph extraction, summaries and answers
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Neo4j — required for the Knowledge Graph pipeline
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# Production: set APP_ENV=production and use a non-default API key.
# This first release uses API-key-to-workspace mapping via API_KEYS_JSON.
# Example: {"long-random-user-key":"workspace-a","another-key":"workspace-b"}
API_KEYS_JSON=
